# Mark the kitty tab busy while a command runs, except in tmux, which doesn't forward the mark
# A program that reports its own status, such as Claude, replaces the mark
if [[ -n $ZSH_VERSION && $TERM == xterm-kitty && -z $TMUX ]]; then
	_kitty_status_preexec() { print -rn -- $'\e]7501;state=working:app=zsh\e\\'; }
	# Leave clearing to kitty's shell integration where it runs, as it keeps done and error reports
	_kitty_status_precmd() {
		(( $+functions[_ksi_precmd] )) || print -rn -- $'\e]7501;state=clear\e\\'
	}
	preexec_functions+=(_kitty_status_preexec)
	precmd_functions+=(_kitty_status_precmd)
fi

# Set the tab's title to the command, else the short directory
if [[ -n $ZSH_VERSION && $TERM == xterm-kitty && -z $TMUX ]]; then
	_kitty_title_precmd() {
		local REPLY host=${SSH_CONNECTION:+${HOST%%.*}: }
		_short_pwd $(( 40 - ${(m)#host} ))
		print -rn -- $'\e]2;'"$host$REPLY"$'\a'
	}
	_kitty_title_preexec() { print -rn -- $'\e]2;'"${SSH_CONNECTION:+${HOST%%.*}: }${(V)1}"$'\a'; }
	precmd_functions+=(_kitty_title_precmd)
	preexec_functions+=(_kitty_title_preexec)
	# Turn off kitty's own titles, which its integration over kitten ssh would write over these
	if [[ -n $KITTY_SHELL_INTEGRATION && $KITTY_SHELL_INTEGRATION != *no-title* ]]; then
		KITTY_SHELL_INTEGRATION+=' no-title'
	fi
fi

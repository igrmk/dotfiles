alias hg='kitty +kitten hyperlinked_grep'
alias icat='kitty +kitten icat'

# Editing themes.conf keeps the theme switch out of the stowed kitty.conf
_kitty_theme() { kitty +kitten themes --reload-in=all --config-file-name themes.conf "$@"; }

sun() { _kitty_theme Garlic Sun; export BRIGHT=high; echo high > ~/.bright; }
moon() { _kitty_theme Garlic Moon; export BRIGHT=low; echo low > ~/.bright; }

pdfcat() {
	output="$(mktemp -d)"
	pdftoppm -scale-to-x 2200 -scale-to-y -1 -png - "$output/pdf" < "$1"
	while IFS= read -r -d '' file
	do
		kitty +kitten icat --stdin yes < "$file"
	done < <(find -s "$output" -type f -name "pdf*.png" -print0)
}

mdcat() {
	read -r -d '' lua_filter <<- 'EOF'
		local function RawText (t)
			return pandoc.RawBlock('tex', t)
		end

		function Meta (m)
			m['header-includes'] = {
				RawText [[\usepackage{tcolorbox}]],
				RawText [[\usepackage{fvextra}]],
				RawText [[\DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines,breakanywhere,commandchars=\\\{\}}]],
			}
			return m
		end

		function CodeBlock (cb)
			return {RawText [[\begin{tcolorbox}]], cb, RawText [[\end{tcolorbox}]]}
		end
	EOF

	output="$(mktemp -d)"
	input="$(realpath "$1")"
	params=(
		--from=markdown
		--to=pdf
		--pdf-engine=xelatex
		--resource-path="$(dirname "$input")"
		-V 'colorlinks:true'
		-V 'mainfont:Inter'
		-V 'pagestyle:empty'
		-V 'monofont:JetBrains Mono'
		-V 'linestretch:1.3'
		-V 'geometry:margin=2cm'
	)
	[ -f ~/.local/share/pandoc/filters/diagram.lua ] && params+=(-L diagram.lua)

	(
		cd "$output" &&
			pandoc "${params[@]}" "$input" --lua-filter=<(printf "%s" "$lua_filter") -o - |
			pdftoppm -scale-to-x 2200 -scale-to-y -1 -png - "$output/pdf"
	)
	while IFS= read -r -d '' file
	do
		kitty +kitten icat --stdin yes < "$file"
	done < <(find "$output" -type f -name "pdf*.png" -print0 | sort -z)
	rm -rf "$output"
}


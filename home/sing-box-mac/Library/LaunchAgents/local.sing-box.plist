<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.sing-box</string>
	<!-- sh resolves $HOME; exec keeps KeepAlive on sing-box. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec /opt/homebrew/opt/sing-box/bin/sing-box run -c "$HOME/.config/sing-box/config.json"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>

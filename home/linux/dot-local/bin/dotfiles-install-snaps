#!/usr/bin/env bash
set -euo pipefail

strict_snaps=(
	losslesscut
	spotify
	telegram-desktop
	yt-dlp
)

classic_snaps=(
	go
	nvim
)

install_snap() {
	local name=$1
	shift
	if snap list "$name" &>/dev/null; then
		echo "$name already installed"
	else
		sudo snap install "$@" "$name"
	fi
}

for s in "${strict_snaps[@]}"; do
	install_snap "$s"
done

for s in "${classic_snaps[@]}"; do
	install_snap "$s" --classic
done

#!/usr/bin/env bash
set -euo pipefail

packages=(
	curl
	fd-find
	ffmpeg
	fzf
	git
	interception-caps2esc
	interception-tools
	kitty-terminfo
	openssh-server
	ripgrep
	stow
	tmux
	tree-sitter-cli
	zoxide
	zplug
	zsh
)

sudo apt-get install -y "${packages[@]}"

echo Ensured:
printf '\t%s\n' "${packages[@]}"

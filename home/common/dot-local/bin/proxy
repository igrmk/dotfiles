#!/usr/bin/env bash
# Run a command with the HTTP proxy environment variables set from ~/.config/proxy.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/proxy"

usage() {
    echo "Usage: proxy <command> [args ...]" >&2
    echo "Settings in $config:" >&2
    echo "    url      = http://user-NAME:PASS@isp.oxylabs.io:8001" >&2
    echo "    no-proxy = localhost,127.0.0.1,::1" >&2
    exit 1
}

[ "$#" -gt 0 ] || usage
[ -f "$config" ] || usage

url=""
no_proxy_list="localhost,127.0.0.1,::1"

# Anything that is not a known key, comments included, falls through unread.
while IFS='=' read -r key value; do
    key="${key//[[:space:]]/}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case $key in
        url) url="$value" ;;
        no-proxy) no_proxy_list="$value" ;;
    esac
done < "$config"

if [ -z "$url" ]; then
    echo "proxy: no url in $config" >&2
    exit 1
fi

# Both cases, because curl reads http_proxy in lowercase only and most other tools take either.
export http_proxy="$url" https_proxy="$url" all_proxy="$url"
export HTTP_PROXY="$url" HTTPS_PROXY="$url" ALL_PROXY="$url"
export no_proxy="$no_proxy_list" NO_PROXY="$no_proxy_list"

exec "$@"

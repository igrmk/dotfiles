get-terminal-background-color() {
	local oldstty result background_code=11 success=false
	exec < /dev/tty
	oldstty=$(stty -g)
	stty raw -echo min 0
	echo -en "\033]${background_code};?\033\\" > /dev/tty

	if IFS=';' read -r -d "\\" color ; then
		result=$(echo "$color" | sed 's/^.*\;//;s/[^rgb:0-9a-f/]//g')
		success=true
	fi

	stty "$oldstty"
	echo "$result"
	return $success
}

# p10k drops its blank line on a new TTY, gluing the first prompt to the login banner
[ -n "$SSH_CONNECTION" ] && echo

# Set the REPLY variable to the working directory, keeping a named directory's name whole,
# fit to the cells the first argument gives, else to the 40 cells tmux and kitty show.
# Shorten middle directories from the left, each to its first letter and then into …,
# only until it fits:
# ~/projects/dotfiles/home/claude/dot-claude becomes ~/p…/dotfiles/home/claude/dot-claude,
# and ~/projects/dotfiles/home/kitty/dot-config/kitty
# becomes ~/…/dotfiles/home/kitty/dot-config/kitty.
if [[ -n $ZSH_VERSION ]]; then
	_short_pwd() {
		local p=${(%):-%~} width=${1:-40} head= dots= short i
		local -a dirs mid parts
		[[ $p == \~* ]] && head=${p%%/*}
		dirs=(${(s:/:)p#$head})
		mid=($dirs[1,-2])
		parts=("$head" $mid $dirs[-1])
		REPLY=${(j:/:)parts}
		for (( i = 1; i <= $#mid && ${(m)#REPLY} > width; i++ )); do
			short=${(M)mid[i]##(.|)?}
			if (( ${(m)#mid[i]} > ${(m)#short} + 1 )); then
				mid[i]=${short}…
				parts=("$head" $dots $mid[i,-1] $dirs[-1])
				REPLY=${(j:/:)parts}
				(( ${(m)#REPLY} <= width )) && break
			fi
			dots=…
			parts=("$head" $dots $mid[i+1,-1] $dirs[-1])
			REPLY=${(j:/:)parts}
		done
		REPLY=${REPLY:-/}
	}
fi

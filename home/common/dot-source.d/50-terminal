get-terminal-background-color() {
	local oldstty result background_code=11 success=false
	exec < /dev/tty
	oldstty=$(stty -g)
	stty raw -echo min 0
	echo -en "\033]${background_code};?\033\\" > /dev/tty

	if IFS=';' read -r -d "\\" color ; then
		result=$(echo "$color" | sed 's/^.*\;//;s/[^rgb:0-9a-f/]//g')
		success=true
	fi

	stty "$oldstty"
	echo "$result"
	return $success
}

# p10k drops its blank line on a new TTY, gluing the first prompt to the login banner
[ -n "$SSH_CONNECTION" ] && echo

# Set the REPLY variable to the working directory, shortened, keeping a named directory's name whole
# ~/projects/kitty/kitty becomes ~/p…/k…/kitty,
# and ~/projects/kitty/kitty/docs/x becomes ~/p…/…/d…/x
if [[ -n $ZSH_VERSION ]]; then
	_short_pwd() {
		local p=${(%):-%~} head= dir short
		local -a dirs mid parts
		[[ $p == \~* ]] && head=${p%%/*}
		dirs=(${(s:/:)p#$head})
		for dir in $dirs[1,-2]; do
			short=${(M)dir##(.|)?}
			(( ${#dir} > ${#short} + 1 )) && dir=${short}…
			mid+=($dir)
		done
		(( $#mid > 3 )) && mid[2,-2]=(…)
		parts=("$head" $mid $dirs[-1])
		REPLY=${(j:/:)parts}
		REPLY=${REPLY:-/}
	}
fi

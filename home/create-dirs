#!/usr/bin/env bash
set -euo pipefail

dirs=(
	"$HOME/.claude"
	"$HOME/.claude/skills"
	"$HOME/.colima/_templates"
	"$HOME/.config/environment.d"
	"$HOME/.config/git"
	"$HOME/.config/karabiner"
	"$HOME/.config/kitty"
	"$HOME/.config/mpv"
	"$HOME/.config/nvim"
	"$HOME/.config/pgcli"
	"$HOME/.ipython/profile_default"
	"$HOME/.local/bin"
	"$HOME/.local/share/pandoc/filters"
	"$HOME/.source.d"
	"$HOME/.vim/config"
)

if [ "$(uname)" = Darwin ]; then
	dirs+=("$HOME/Library/LaunchAgents")
fi

install -d -m 700 "${dirs[@]}"
